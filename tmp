# 2. Match historical scenarios. Rank losses separately for each treatment.
def ranked_losses(calculator, method):
    """Break equal-loss ties by shock date for a reproducible ranking."""
    loss_col = f"{method}_loss"
    return (
        calculator._daily_spreads
        .select(
            pl.col(calculator._date_col["spread_changes"]).alias("shock_date"),
            pl.col(calculator._value_col["csrbb_daily_risk"]).alias(loss_col),
        )
        .sort([loss_col, "shock_date"], descending=[True, False])
        .with_row_index(f"{method}_rank", offset=1)
    )


loss_tables = {
    method: ranked_losses(calculator, method)
    for method, calculator in calculators.items()
}
comparison = loss_tables["midpoint"]
for method in ("combined", "split", "actual"):
    comparison = comparison.join(
        loss_tables[method], on="shock_date", how="inner", validate="1:1"
    )
if comparison.is_empty() or any(
    comparison.height != table.height for table in loss_tables.values()
):
    raise ValueError("The four runs have different or empty shock-date sets.")

focus = comparison.filter(pl.col("shock_date").is_in(focus_dates)).sort("shock_date")
if focus.height != len(focus_dates):
    raise ValueError("A selected chart date is absent. Check focus_dates above.")


# 3. Explain selected scenario losses by maturity bucket and balance-sheet side.
def bucket_losses(calculator, method, shock_dates):
    """Sum signed base PV minus shocked PV before comparing methods."""
    date_col = calculator._date_col["spread_changes"]
    bucket_col = calculator._mapped_bucket_col["present_values"]
    side_col = calculator._banking_book_type_col["present_values"]
    base_pv = calculator._value_col["present_values"]
    shocked_pv = calculator._value_col["shocked_present_value"]
    return (
        calculator._spread_risk_details
        .filter(pl.col(date_col).is_in(shock_dates))
        .group_by([date_col, bucket_col, side_col])
        .agg(
            (pl.col(base_pv).sum() - pl.col(shocked_pv).sum())
            .alias(f"{method}_loss")
        )
        .rename({date_col: "shock_date", bucket_col: "bucket", side_col: "side"})
    )


keys = ["shock_date", "bucket", "side"]
by_bucket = bucket_losses(midpoint_calculator, "midpoint", focus_dates)
for method in ("combined", "split", "actual"):
    by_bucket = by_bucket.join(
        bucket_losses(calculators[method], method, focus_dates),
        on=keys, how="full", coalesce=True, validate="1:1",
    )
if any(by_bucket[f"{method}_loss"].null_count() for method in calculators):
    raise ValueError("A bucket or side is missing from one of the four runs.")

# Allow one cent for floating-point summation differences. Check every method.
reconciliation_rows = []
for row in focus.to_dicts():
    scenario = by_bucket.filter(pl.col("shock_date") == row["shock_date"])
    for method in calculators:
        bucket_total = scenario[f"{method}_loss"].sum()
        difference = bucket_total - row[f"{method}_loss"]
        if not isclose(difference, 0, rel_tol=0, abs_tol=0.01):
            raise ValueError(f"Bucket reconciliation failed for {method}.")
        reconciliation_rows.append({
            "shock_date": row["shock_date"], "method": method,
            "bucket_total_eur": bucket_total, "difference_eur": difference,
        })


# 4. Prepare the report. Later tables and figures reuse stored results only.
report_dir = Path("mt4_comparison") / datetime.now().strftime("%Y%m%d_%H%M%S")
