# Rank scenario losses separately for each method.
ranked = losses

for name in runs:
    ranks = (
        losses.select("date", name)
        .sort([name, "date"], descending=[True, False])
        .with_row_index(f"{name}_rank", offset=1)
        .select("date", f"{name}_rank")
    )
    ranked = ranked.join(ranks, on="date", validate="1:1")

# Calculate changes from the midpoint scenario loss.
change_cols = [
    (pl.col(name) - pl.col("Midpoints")).alias(f"{name} change")
    for name in methods
]
ranked = ranked.with_columns(change_cols)


# Original comparison of the ten worst midpoint or split scenarios.
tail10 = (
    ranked.filter(
        (pl.col("Midpoints_rank") <= 10)
        | (pl.col("Split_rank") <= 10)
    )
    .sort("Split_rank")
)

# Five worst scenarios from any of the four methods.
tail5 = (
    ranked.filter(
        pl.any_horizontal([
            pl.col(f"{name}_rank") <= 5
            for name in runs
        ])
    )
    .sort("Actual dates_rank")
)


# Original investigation of the second and third worst split scenarios.
driver_dates = (
    ranked.filter(pl.col("Split_rank").is_in([2, 3]))
    ["date"].to_list()
)

tail_buckets = bucket_losses(normal, "Midpoints", driver_dates)

for name, calc in list(runs.items())[1:]:
    tail_buckets = tail_buckets.join(
        bucket_losses(calc, name, driver_dates),
        on=["date", "bucket", "side"],
        how="full",
        coalesce=True,
        validate="1:1",
    )

if any(tail_buckets[name].null_count() for name in runs):
    raise ValueError("A bucket or side is missing from one run.")

detail = tail_buckets.with_columns(change_cols)

# Five largest bucket changes for each date, ranked by absolute split change.
top_drivers = (
    detail
    .sort(
        ["date", pl.col("Split change").abs()],
        descending=[False, True],
    )
    .group_by("date", maintain_order=True)
    .head(5)
)


# Reconcile all bucket changes with the portfolio scenario change.
reconciliation = (
    detail.group_by("date")
    .agg(
        pl.col("Split change").sum().alias("bucket_total"),
        pl.col("Split change").null_count().alias("missing_groups"),
    )
    .join(
        ranked.select("date", "Split change"),
        on="date",
        validate="1:1",
    )
    .with_columns(
        (pl.col("bucket_total") - pl.col("Split change"))
        .alias("difference")
    )
    .sort("date")
)

if not np.all(
    np.isclose(
        reconciliation["difference"].to_numpy(),
        0,
        atol=0.01,
        rtol=0,
    )
):
    raise ValueError("Bucket changes do not reconcile.")


# Show complete tables. Losses and changes are in EUR.
with pl.Config(tbl_rows=-1, tbl_cols=-1):
    print("Ten worst midpoint or split scenarios")
    display(tail10)

    print("Five worst scenarios across all four methods")
    display(tail5)

    print("Five largest bucket changes for each investigated date")
    display(top_drivers)

    print("Bucket changes reconciled to the portfolio change")
    display(reconciliation)


# Save the detailed tables.
tail10.write_csv("mt4_top10_scenarios.csv")
tail5.write_csv("mt4_top5_scenarios.csv")
top_drivers.write_csv("mt4_top5_bucket_drivers.csv")
reconciliation.write_csv("mt4_tail_reconciliation.csv")
