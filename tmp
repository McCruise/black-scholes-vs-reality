# 6. Separate the two liability buckets examined earlier from the rest.
time_buckets = midpoint_calculator.config["mappings"]["time_buckets"]
groups = [
    time_buckets["bucket_10"]["desc"] + "\nliabilities",
    time_buckets["bucket_11"]["desc"] + "\nliabilities",
    "Rest of portfolio",
]
liability = pl.col("side") == "liability"
changes = (
    by_bucket.with_columns(
        pl.when(liability & (pl.col("bucket") == "bucket_10")).then(pl.lit(groups[0]))
        .when(liability & (pl.col("bucket") == "bucket_11")).then(pl.lit(groups[1]))
        .otherwise(pl.lit(groups[2])).alias("group"),
        (pl.col("combined_loss") - pl.col("midpoint_loss")).alias("combined_change"),
        (pl.col("split_loss") - pl.col("midpoint_loss")).alias("split_change"),
        (pl.col("actual_loss") - pl.col("midpoint_loss")).alias("actual_change"),
    )
    .group_by(["shock_date", "group"])
    .agg(pl.col("combined_change", "split_change", "actual_change").sum())
)
figure, axes = plt.subplots(1, len(focus_dates), figsize=(12, 5), sharey=True, squeeze=False)
for axis, shock_date in zip(axes[0], sorted(focus_dates)):
    scenario = changes.filter(pl.col("shock_date") == shock_date)
    for index, method in enumerate(("combined", "split", "actual")):
        amounts = {row["group"]: row[f"{method}_change"] for row in scenario.to_dicts()}
        values = [amounts.get(group, 0) / 1e6 for group in groups]
        axis.bar(np.arange(3) + (index - 1) * 0.24, values, width=0.24,
                 label=labels[method], color=colors[index + 1])
    axis.set_xticks(np.arange(3), groups)
    axis.set_title(str(shock_date))
    axis.axhline(0, color="#65717E", linewidth=0.8)
    axis.set_axisbelow(True)
    axis.grid(axis="y", alpha=0.2)
axes[0, 0].set_ylabel("Change in scenario loss from midpoints, EUR m")
handles, legend_labels = axes[0, 0].get_legend_handles_labels()
figure.legend(handles, legend_labels, loc="lower center", ncol=3, frameon=False)
figure.suptitle("Where the selected scenario loss changes arise", fontweight="bold")
