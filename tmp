})


def finish_figure(figure, filename):
    figure.savefig(report_dir / filename, dpi=220, bbox_inches="tight")
    plt.show()
    plt.close(figure)


def show_table(frame, title, filename, formats):
    """Create a formatted table image and display it in the notebook."""
    rows = []
    for row in frame.iter_rows(named=True):
        cells = []
        for column in frame.columns:
            value = row[column]
            if value is None:
                cells.append("n/a")
            elif column in formats:
                cells.append(format(value, formats[column]))
            else:
                cells.append(str(value))
        rows.append(cells)
    figure, axis = plt.subplots(figsize=(12, 1.3 + 0.4 * len(rows)))
    axis.axis("off")
    axis.set_title(title, loc="left", fontweight="bold", pad=14)
    table = axis.table(cellText=rows, colLabels=frame.columns, loc="center")
    table.auto_set_font_size(False)
    table.set_fontsize(10)
    table.scale(1, 1.5)
    table.auto_set_column_width(list(range(frame.width)))
    for (row, column), cell in table.get_celld().items():
        cell.set_edgecolor("white")
        cell.set_facecolor("#F0F4F8" if row % 2 else "white")
        if row == 0:
            cell.set_facecolor("#193B58")
            cell.set_text_props(color="white", fontweight="bold")
    figure.tight_layout()
    finish_figure(figure, filename)


# Capital is recalculated by the engine. Bucket VaRs are never added together.
midpoint_hvar = midpoint_calculator._results
summary_rows = []
for method, calculator in calculators.items():
    hvar = calculator._results
    change_pct = 100 * (hvar / midpoint_hvar - 1) if midpoint_hvar else None
    summary_rows.append({
        "Method": labels[method], "HVaR (EUR m)": hvar / 1e6,
        "Change (EUR m)": (hvar - midpoint_hvar) / 1e6,
        "Change (%)": change_pct,
    })
summary = pl.DataFrame(summary_rows)
show_table(summary, "CSRBB HVaR compared with midpoints", "01_capital_table.png", {
    "HVaR (EUR m)": ",.3f", "Change (EUR m)": "+,.3f", "Change (%)": "+.2f",
})

# Check the factor actually stored in valuation, including actual-date variation.
factor_rows = []
for method, calculator in calculators.items():
    bucket_col = calculator._mapped_bucket_col["present_values"]
    side_col = calculator._banking_book_type_col["present_values"]
    factor_col = calculator._value_col["time_factors"]
    factors = (
        calculator._present_values.filter(pl.col(bucket_col) == "bucket_01")
