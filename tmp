def run_challenger(config, side_factors=None, actual_dates=False):
    """Run one challenger with an independent copy of the normal configuration."""
    calculator = CsrbbEngine(
        path_to_config=midpoint_calculator._config_path,
        config=deepcopy(config),
        stress_mode=None,
        path_to_sensitivity_config=path_sensi_config,
    )
    calculator.time_factors_by_side = side_factors
    calculator.mt4_actual_dates = actual_dates
    calculator.run_all()
    if calculator._results is None or not isfinite(calculator._results):
        raise RuntimeError("A challenger failed. Check its engine log.")
    return calculator


# Reject undefined weighted maturities, including zero-weight averages.
for factors in (cashflows_all_dict, cashflows_dict_assets, cashflows_dict_liabs):
    if any(value is None or not isfinite(value) for value in factors.values()):
        raise ValueError("A weighted maturity is missing or non-finite.")

