    def _mt4_curve(self, rows, kind, mode):
        """Replace a curve input using each cashflow's payment maturity."""
        if mode == "current":
            return rows

        import numpy as np

        if mode not in ("lower", "upper", "linear", "pchip"):
            raise ValueError(f"Unknown curve test: {mode}")

        if not getattr(self, "mt4_actual_dates", False):
            raise ValueError("Curve tests require actual payment dates.")

        if mode == "pchip":
            from scipy.interpolate import PchipInterpolator

        factor = self._value_col["time_factors"]
        value = self._value_col[kind]

        # Match the same currency and credit curve as the normal calculation.
        key_maps = [self._currency_col]
        if kind != "interest_rates":
            key_maps += [
                self._segment_col,
                self._region_col,
                self._mapped_rating_col,
            ]

        row_keys = [mapping["present_values"] for mapping in key_maps]
        curve_keys = [mapping[kind] for mapping in key_maps]

        if kind == "spread_changes":
            row_keys += [self._date_col[kind]]
            curve_keys += [self._date_col[kind]]

        tenor = (
            self._mapped_bucket_col[kind]
            if kind == "interest_rates"
            else self._input_bucket_col[kind]
        )

        mapping_name = (
            "interest_rates_buckets"
            if kind == "interest_rates"
            else "credit_spread_to_buckets"
        )
        expected = set(self.config["mappings"][mapping_name].values())

        def years(label):
            label = label.split("|")[0].upper()
            if label in ("ON", "O/N"):
                return 1 / 365
            if label.endswith("M"):
                return float(label[:-1]) / 12
            if label.endswith("Y"):
                return float(label[:-1])
            raise ValueError(f"Unknown tenor: {label}")

        curves = getattr(self, kind).select(
            *[
                pl.col(source).alias(target)
                for source, target in zip(curve_keys, row_keys)
            ],
            pl.col(tenor).alias("_tenor"),
            pl.col(value).alias("_value"),
        )

        curve_groups = curves.partition_by(row_keys, as_dict=True)
        requests = rows.select(row_keys + [factor]).unique()
        parts = []

        # Calculate once per curve, scenario and distinct payment maturity.
        for key, group in requests.partition_by(
            row_keys, as_dict=True
        ).items():
            if key not in curve_groups:
                raise ValueError(f"Missing {kind} curve: {key}")

            curve = curve_groups[key]
            labels = curve["_tenor"].to_list()

            if set(labels) != expected or len(labels) != len(expected):
                raise ValueError(f"Missing or duplicate {kind} tenors: {key}")

            x = np.array([years(label) for label in labels])
            y = curve["_value"].cast(pl.Float64).to_numpy()
            order = np.argsort(x)
            x, y = x[order], y[order]

            t = group[factor].cast(pl.Float64).to_numpy()

            if (
                not np.isfinite(y).all()
                or not np.isfinite(t).all()
                or (t < 0).any()
                or (np.diff(x) <= 0).any()
            ):
                raise ValueError(f"Invalid {kind} curve or maturity: {key}")

            # Flat endpoints: no extrapolation outside available tenors.
            t = np.clip(t, x[0], x[-1])

            if mode == "lower":
                index = np.searchsorted(x, t, side="right") - 1
                result = y[np.clip(index, 0, len(x) - 1)]
            elif mode == "upper":
                index = np.searchsorted(x, t, side="left")
                result = y[np.clip(index, 0, len(x) - 1)]
            elif mode == "linear":
                result = np.interp(t, x, y)
            else:
                result = PchipInterpolator(x, y, extrapolate=False)(t)

            parts.append(
                group.with_columns(pl.Series(value, result))
            )

        replacement = pl.concat(parts)

        # Replace only the numeric input; preserve the original row order.
        return (
            rows.with_row_index("_mt4_row")
            .drop(value)
            .join(
                replacement,
                on=row_keys + [factor],
                how="left",
                validate="m:1",
            )
            .sort("_mt4_row")
            .drop("_mt4_row")
        )







######################################


        # Optional curve-mapping tests.
        present_value_helper = self._mt4_curve(
            present_value_helper,
            "interest_rates",
            getattr(self, "mt4_ir_method", "current"),
        )

        present_value_helper = self._mt4_curve(
            present_value_helper,
            "spread_curves",
            getattr(self, "mt4_cs_method", "current"),
        )


#############################################

        # Apply the same credit-spread method to each historical shock.
        spread_risk_helper = self._mt4_curve(
            spread_risk_helper,
            "spread_changes",
            getattr(self, "mt4_cs_method", "current"),
        )

