import polars as pl

def ranked_losses(calc, run):
    loss_col = f"{run}_loss"
    return (
        calc._daily_spreads
        .select(
            pl.col(calc._date_col["spread_changes"]).alias("shock_date"),
            pl.col(calc._value_col["csrbb_daily_risk"]).alias(loss_col),
        )
        .sort([loss_col, "shock_date"], descending=[True, False])
        .with_row_index(f"{run}_rank", offset=1)
    )

split = ranked_losses(csrbb_calculator, "split")

midpoint_calculator = CsrbbEngine(
    path_to_config="./core_config_regular.yaml",
    stress_mode=stress_testing_mode,
    path_to_sensitivity_config=path_sensi_config,
)
midpoint_calculator.run_all()
midpoint = ranked_losses(midpoint_calculator, "midpoint")

paired = midpoint.join(split, on="shock_date", validate="1:1")
if paired.height != midpoint.height or paired.height != split.height:
    raise ValueError("The two runs have different shock dates.")

tail = (
    paired
    .filter((pl.col("midpoint_rank") <= 10) | (pl.col("split_rank") <= 10))
    .with_columns(
        (pl.col("split_loss") - pl.col("midpoint_loss")).alias("split_minus_midpoint")
    )
    .sort("split_rank")
)

print(f"Midpoint HVaR: {midpoint_calculator._results:,.2f}")
print(f"Split HVaR:    {csrbb_calculator._results:,.2f}")
display(tail)
